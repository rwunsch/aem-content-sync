# Copy this to .env and fill in your values. Never commit .env.

# Adobe IMS / Developer Console (OAuth server-to-server)
IMS_ORG_ID=YOUR_IMS_ORG_ID@AdobeOrg
CM_CLIENT_ID=
CM_CLIENT_SECRET=
CM_TECHNICAL_ACCOUNT_ID=
# CM_PRIVATE_KEY only needed for JWT credentials (legacy); leave empty for OAuth S2S
CM_PRIVATE_KEY=

# AEM Author (destination)
# URL of the destination AEM Author instance
AEM_AUTHOR_URL=https://author-p<programId>-e<envId>.adobeaemcloud.com
# Bearer token for AEM Author API calls
# Get via: curl -X POST https://ims-na1.adobelogin.com/ims/token/v3 ...
# Or use the same IMS technical account token if the account has AEM Admin role
AEM_TOKEN=

# Slack
SLACK_WEBHOOK_URL=

# App Builder (from `aio app use` / Developer Console workspace)
AIO_runtime_namespace=
AIO_runtime_auth=
